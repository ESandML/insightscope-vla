# Copy to .env and adjust. Never commit .env.
# Phase 2 only: these are read by the local model client.

# Ollama exposes an OpenAI-compatible endpoint on this path.
INSIGHTSCOPE_LLM_BASE_URL=http://localhost:11434/v1
INSIGHTSCOPE_LLM_API_KEY=ollama

# Vision model for keyframes; text model for extraction and critique.
INSIGHTSCOPE_VISION_MODEL=llama3.2-vision
INSIGHTSCOPE_TEXT_MODEL=llama3.1:8b

# Per-call timeout in seconds. Generous: CPU inference is slow.
INSIGHTSCOPE_LLM_TIMEOUT_S=120
